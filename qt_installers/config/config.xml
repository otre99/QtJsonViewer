<?xml version="1.0" encoding="UTF-8"?>
<!--
  Qt Installer Framework configuration for the QtJsonViewer offline installer.
  __APP_VERSION__ is replaced by build_installer.sh at build time.
-->
<Installer>
    <Name>QtJsonViewer</Name>
    <Version>__APP_VERSION__</Version>
    <Title>QtJsonViewer __APP_VERSION__ Installer</Title>
    <Publisher>Roberto Carlos Cruz Rodriguez</Publisher>
    <ProductUrl>https://github.com/otre99/QtJsonViewer</ProductUrl>

    <!-- InstallerApplicationIcon: name without extension (.ico on Windows, .icns on macOS; unused on Linux) -->
    <InstallerApplicationIcon>QtJsonViewer</InstallerApplicationIcon>
    <InstallerWindowIcon>QtJsonViewer.png</InstallerWindowIcon>
    <Logo>logo.png</Logo>

    <WizardStyle>Modern</WizardStyle>
    <WizardDefaultWidth>640</WizardDefaultWidth>
    <WizardDefaultHeight>480</WizardDefaultHeight>

    <StartMenuDir>QtJsonViewer</StartMenuDir>
    <TargetDir>@HomeDir@/QtJsonViewer</TargetDir>
    <AdminTargetDir>@ApplicationsDir@/QtJsonViewer</AdminTargetDir>
    <AllowNonAsciiCharacters>true</AllowNonAsciiCharacters>
    <AllowSpaceInPath>true</AllowSpaceInPath>

    <MaintenanceToolName>QtJsonViewerMaintenanceTool</MaintenanceToolName>
    <RunProgram>@TargetDir@/bin/QtJsonViewer</RunProgram>
    <RunProgramDescription>Launch QtJsonViewer now</RunProgramDescription>
</Installer>
